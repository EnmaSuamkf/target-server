# Local-only throwaway values for the OTEL 0 spike. Not secrets. Use with:
#   docker compose --env-file .env.example up -d
# Headless initialization (https://langfuse.com/self-hosting/administration/headless-initialization)
LANGFUSE_INIT_ORG_ID=phase0-org
LANGFUSE_INIT_ORG_NAME=Phase0 Org
LANGFUSE_INIT_PROJECT_ID=phase0-project
LANGFUSE_INIT_PROJECT_NAME=Phase0 Project
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=pk-lf-phase0-local-dummy
LANGFUSE_INIT_PROJECT_SECRET_KEY=sk-lf-phase0-local-dummy
LANGFUSE_INIT_USER_EMAIL=phase0@example.com
LANGFUSE_INIT_USER_NAME=Phase0
LANGFUSE_INIT_USER_PASSWORD=phase0-local-password
