# Local-only throwaway values for a Langfuse running on this machine. They are
# not secrets: never reuse them anywhere reachable from a network.
# Headless initialization: https://langfuse.com/self-hosting/administration/headless-initialization
NEXTAUTH_URL=http://localhost:3001
LANGFUSE_INIT_ORG_ID=target-demo-org
LANGFUSE_INIT_ORG_NAME=Target Demo
LANGFUSE_INIT_PROJECT_ID=target-demo-project
LANGFUSE_INIT_PROJECT_NAME=Target Demo
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=pk-lf-target-demo-local
LANGFUSE_INIT_PROJECT_SECRET_KEY=sk-lf-target-demo-local
LANGFUSE_INIT_USER_EMAIL=demo@example.com
LANGFUSE_INIT_USER_NAME=Demo
LANGFUSE_INIT_USER_PASSWORD=target-demo-local-password
