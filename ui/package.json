{
  "name": "target-server-ui",
  "version": "0.1.0",
  "description": "Report dashboard for The Target Project's central server — React + Vite single-page app, built to ../public/dist and served as static files by server.mjs.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "typescript": "^5.9.3",
    "vite": "^7.1.9"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
